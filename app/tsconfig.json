{
    "compilerOptions": {
        "rootDir": "./src",
        "types": [],
        "target": "esnext",
        "module": "esnext",
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": false,
        "strict": true,
        "jsx": "react-jsx",
        "verbatimModuleSyntax": false,
        "isolatedModules": true,
        "noUncheckedSideEffectImports": true,
        "moduleDetection": "force",
        "skipLibCheck": true,
        "paths": {
            "@app/*": [
                "./src/js/*"
            ]
        }
    },
    "include": [
        "src/**/*",
        "index.d.ts",
    ],
    "exclude": [
        "node_modules",
        "public",
        "server-build"
    ]
}
